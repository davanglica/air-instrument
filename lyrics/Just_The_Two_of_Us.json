                "34": "Em7"
            }
        },
        {
            "text": "[Verse 2]",
            "chords": {}
        },
        {
            "text": "We look for love, no time for tears",
            "chords": {
                "0": "Cmaj7",
                "15": "B7",
                "30": "Em7"
            }
        },
        {
            "text": "Wasted water's all that is",
