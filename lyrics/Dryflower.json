  "lyrics": [
    {
      "text": "多分、私じゃなくていいね",
      "chords": {
        "0": "C",
        "3": "G"
      }
    },
    {
      "text": "余裕のない二人だったし",
      "chords": {
        "0": "D",
        "5": "Em"
      }
    },
    {
      "text": "気付けば喧嘩ばっかり",
      "chords": {
        "0": "C",
        "4": "G"
      }
    },
    {
      "text": "してさごめんね",
      "chords": {
        "3": "D",
        "6": "Em"
      }
    },
    {
      "text": "ずっと話そうと思ってた",
      "chords": {
        "0": "C",
        "8": "G"
      }
    },
    {
      "text": "きっと私たち合わないね",
      "chords": {
        "0": "D",
        "6": "Em"
      }
    },
    {
      "text": "二人きりしかいない部屋でさ",
      "chords": {
        "0": "C",
        "10": "G"
      }
    },
    {
      "text": "貴方ばかり話していたよね",
      "chords": {
        "0": "D"
      }
    },
    {
      "text": "もし いつか何処かで会えたら",
      "chords": {
        "0": "Em",
        "3": "C",
        "9": "D",
        "12": "G",
        "13": "D"
      }
    },
    {
      "text": "今日の事を笑ってくれるかな",
      "chords": {
        "0": "Em",
        "2": "C",
        "7": "D",
        "11": "G",
        "12": "D"
      }
    },
    {
      "text": "理由もちゃんと話せないけれど",
      "chords": {
        "0": "Em",
        "4": "C",
        "9": "Bm",
        "11": "B7",
        "13": "Em"
      }
    },
    {
      "text": "貴方が眠った後に泣くのは嫌",
      "chords": {
        "0": "Am",
        "8": "C",
        "13": "B7"
      }
    },
    {
      "text": "声も顔も不器用なとこも",
      "chords": {
        "0": "C",
        "2": "G",
        "5": "D",
        "7": "B7",
        "10": "Em"
      }
    },
    {
      "text": "全部全部嫌いじゃないの",
      "chords": {
        "0": "C",
        "2": "G",
        "4": "D",
        "8": "B7",
        "10": "Em"
      }
    },
    {
      "text": "ドライフラワーみたい",
      "chords": {
        "0": "C",
        "9": "G"
      }
    },
    {
      "text": "君との日々も",
      "chords": {
        "0": "B7",
        "4": "Em"
      }
    },
    {
      "text": "きっときっときっと",
      "chords": {
        "0": "Am"
      }
    },
    {
      "text": "きっと色褪せる",
      "chords": {
        "3": "Cm",
        "5": "D"
      }
    },
    {
      "text": "多分、君じゃなくてよかった",
      "chords": {
        "0": "C",
        "9": "G"
      }
    },
    {
      "text": "もう泣かされることもないし",
      "chords": {
        "2": "D",
        "10": "Em"
      }
    },
    {
      "text": "「私ばかり」なんて",
      "chords": {
        "0": "C",
        "7": "G"
      }
    },
    {
      "text": "言葉もなくなった",
      "chords": {
        "0": "D",
        "4": "Em"
      }
    },
    {
      "text": "あんなに悲しい別れでも",
      "chords": {
        "0": "C",
        "9": "G"
      }
    },
    {
      "text": "時間がたてば忘れてく",
      "chords": {
        "3": "D",
        "8": "Em"
      }
    },
    {
      "text": "新しい人と並ぶ君は",
      "chords": {
        "0": "C",
        "8": "G"
      }
    },
    {
      "text": "ちゃんとうまくやれているのかな",
      "chords": {
        "6": "D"
      }
    },
    {
      "text": "もう顔も見たくないからさ",
      "chords": {
        "0": "Em",
        "2": "C",
        "7": "D",
        "10": "G",
        "11": "D"
      }
    },
    {
      "text": "変に連絡してこないでほしい",
      "chords": {
        "0": "Em",
        "2": "C",
        "7": "D",
        "11": "G",
        "12": "B7"
      }
    },
    {
      "text": "都合がいいのは",
      "chords": {
        "0": "Em",
        "4": "C"
      }
    },
    {
      "text": "変わってないんだね",
      "chords": {
        "0": "Bm",
        "2": "B7",
        "5": "Em"
      }
    },
    {
      "text": "でも無視できずにまた少し返事",
      "chords": {
        "0": "Am",
        "8": "C",
        "12": "B7"
      }
    },
    {
      "text": "声も顔も不器用なとこも",
      "chords": {
        "0": "C",
        "2": "G",
        "5": "D",
        "7": "B7",
        "10": "Em"
      }
    },
    {
      "text": "多分今も嫌いじゃないの",
      "chords": {
        "0": "C",
        "2": "G",
        "4": "D",
        "8": "B7",
        "10": "Em"
      }
    },
    {
      "text": "ドライフラワーみたく",
      "chords": {
        "0": "C",
        "8": "G"
      }
    },
    {
      "text": "時間が経てば",
      "chords": {
        "0": "B7",
        "4": "Em"
      }
    },
    {
      "text": "きっときっときっと",
      "chords": {
        "0": "Am"
      }
    },
    {
      "text": "きっと色褪せる",
      "chords": {
        "3": "Cm",
        "5": "D"
      }
    },
    {
      "text": "月灯りに魔物が揺れる",
      "chords": {
        "0": "C"
      }
    },
    {
      "text": "きっと私もどうかしてる",
      "chords": {
        "4": "D"
      }
    },
    {
      "text": "暗闇に色彩が浮かぶ",
      "chords": {
        "0": "Em",
        "6": "Bm"
      }
    },
    {
      "text": "赤黄藍色が胸の奥",
      "chords": {
        "0": "C"
      }
    },
    {
      "text": "ずっと貴方の名前を呼ぶ",
      "chords": {
        "3": "D"
      }
    },
    {
      "text": "好きという気持ちまた香る",
      "chords": {
        "0": "C",
        "10": "D",
        "12": "B7"
      }
    },
    {
      "text": "声も顔も不器用なとこも",
      "chords": {
        "0": "C",
        "2": "G",
        "5": "D",
        "7": "B7",
        "10": "Em"
      }
    },
    {
      "text": "全部全部大嫌いだよ",
      "chords": {
        "0": "C",
        "2": "G",
        "5": "B7",
        "8": "Em"
      }
    },
    {
      "text": "まだ枯れない花を君に添えてさ",
      "chords": {
        "0": "C",
        "6": "G",
        "9": "B7",
        "13": "Em"
      }
    },
    {
      "text": "ずっとずっと",
      "chords": {
        "0": "Am"
      }
    },
    {
      "text": "ずっとずっと抱えてよ",
      "chords": {
