  "lyrics": [
    {
      "text": "風の強さがちょっと",
      "chords": {
        "0": "C",
        "7": "G"
      }
    },
    {
      "text": "心を揺さぶりすぎて",
      "chords": {
        "0": "Am",
        "9": "G"
      }
    },
    {
      "text": "真面目に見つめた",
      "chords": {
        "0": "F",
        "4": "C"
      }
    },
    {
      "text": "君が恋しい",
      "chords": {
        "0": "F",
        "3": "G"
      }
    },
    {
      "text": "でんぐり返しの日々",
      "chords": {
        "0": "C",
        "7": "G"
      }
    },
    {
      "text": "可哀想なふりをして",
      "chords": {
        "0": "Am",
        "9": "G"
      }
    },
    {
      "text": "だらけてみたけど",
      "chords": {
        "0": "F",
        "4": "C"
      }
    },
    {
      "text": "希望の光は",
      "chords": {
        "0": "F",
        "3": "G"
      }
    },
    {
      "text": "目の前でずっと 輝いている",
      "chords": {
        "0": "Am",
        "9": "Em"
      }
    },
    {
      "text": "幸せだ",
      "chords": {
        "0": "F",
        "2": "G"
      }
    },
    {
      "text": "麦わらの帽子の君が",
      "chords": {
        "0": "C",
        "8": "G"
      }
    },
    {
      "text": "揺れた マリーゴールドに似てる",
      "chords": {
        "0": "Am",
        "13": "G"
      }
    },
    {
      "text": "あれは空がまだ青い 夏のこと",
      "chords": {
        "0": "F",
        "9": "C",
        "12": "Am"
      }
    },
    {
      "text": "懐かしいと笑えたあの日の恋",
      "chords": {
        "0": "F",
        "11": "G"
      }
    },
    {
      "text": "「もう離れないで」と",
      "chords": {
        "0": "C",
        "8": "G"
      }
    },
    {
      "text": "泣きそ うな目で見つめる君を",
      "chords": {
        "0": "Am",
        "12": "G"
      }
    },
    {
      "text": "雲のような優しさで",
      "chords": {
        "0": "F",
        "8": "C"
      }
    },
    {
      "text": "そっと ぎゅっと",
      "chords": {
        "4": "Am"
      }
    },
    {
      "text": "抱きしめて抱きしめて 離さない",
      "chords": {
        "0": "F",
        "11": "G"
      }
    },
    {
      "text": "本当の気持ち全部",
      "chords": {
        "0": "C",
        "7": "G"
      }
    },
    {
      "text": "吐き出 せるほど強くはない",
      "chords": {
        "0": "Am",
        "10": "G"
      }
    },
    {
      "text": "でも不思議なくらいに",
      "chords": {
        "0": "F",
        "7": "C"
      }
    },
    {
      "text": "絶望は見えない",
      "chords": {
        "0": "F",
        "4": "G"
      }
    },
    {
      "text": "目の奥にずっと 写るシルエット",
      "chords": {
        "0": "Am",
        "9": "Em"
      }
    },
    {
      "text": "大好きさ",
      "chords": {
        "0": "F",
        "2": "G"
      }
    },
    {
      "text": "柔らかな肌を寄せあい",
      "chords": {
        "0": "C",
        "9": "G"
      }
    },
    {
      "text": "少し 冷たい空気を2人",
      "chords": {
        "0": "Am",
        "10": "G"
      }
    },
    {
      "text": "かみしめて歩く今日という日に",
      "chords": {
        "0": "F",
        "9": "C"
      }
    },
    {
      "text": "何と名前をつけようか",
      "chords": {
        "0": "Am",
        "6": "F"
      }
    },
    {
      "text": "なんて話して",
      "chords": {
        "4": "G"
      }
    },
    {
      "text": "ああ アイラブユーの言葉 じゃ",
      "chords": {
        "0": "C",
        "8": "G",
        "13": "Am"
      }
    },
    {
      "text": "足りないからとキスして",
      "chords": {
        "7": "G"
      }
    },
    {
      "text": "雲がまだ2人の影を残 すから",
      "chords": {
        "0": "F",
        "9": "C",
        "13": "Am"
      }
    },
    {
      "text": "いつまでも いつまでも このまま",
      "chords": {
        "0": "F",
        "11": "G"
      }
    },
    {
      "text": "遥か遠い場所にいても",
      "chords": {
        "0": "Am",
        "5": "G",
        "9": "C"
      }
    },
    {
      "text": "繋がっていたいなぁ",
      "chords": {
