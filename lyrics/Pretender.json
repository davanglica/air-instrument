        {
            "text": "「君は綺麗だ」",
            "chords": { "1": "Cmaj7" }
        },
        {
            "text": "それも これも ロマンスの定めなら",
            "chords": { "3": "Bm7", "6": "Am", "9": "B7" }
        },
        {
            "text": "悪くないよな",
            "chords": { "0": "Em", "3": "D" }
        },
        {
            "text": "永遠も 約束も ないけれど",
            "chords": { "0": "Cmaj7", "3": "Bm7", "6": "Am" }
