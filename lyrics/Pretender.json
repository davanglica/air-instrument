    "lyrics": [
        {
            "text": "君とのラブストーリー",
            "chords": { "0": "G", "6": "D" }
        },
        {
            "text": "それは予想通り",
            "chords": { "0": "B7", "3": "Em" }
        },
        {
            "text": "いざ始まればひとり芝居だ",
            "chords": { "6": "A" }
        },
        {
            "text": "ずっとそばにいたって",
            "chords": { "0": "Am" }
        },
        {
            "text": "結局ただの観客だ",
            "chords": { "0": "C", "3": "D" }
        },
        {
            "text": "感情のないアイムソーリー",
            "chords": { "0": "G", "7": "D" }
        },
        {
            "text": "それはいつも通り",
            "chords": { "0": "B7", "4": "Em" }
        },
        {
            "text": "慣れてしまえば悪くはないけど",
            "chords": { "6": "A" }
        },
        {
            "text": "君とのロマンスは人生柄",
            "chords": { "0": "Am", "9": "D" }
        },
        {
            "text": "続きはしないことを知った",
            "chords": { "0": "G" }
        },
        {
            "text": "もっと違う設定で もっと違う関係で",
            "chords": { "0": "Cmaj7", "6": "B7", "9": "Em", "15": "Dm7", "18": "G" }
        },
        {
            "text": "出会える世界線 選べたらよかった",
            "chords": { "0": "Cmaj7", "6": "B7", "8": "Em", "13": "Dm7" }
        },
        {
            "text": "もっと違う性格で もっと違う価値観で",
            "chords": { "0": "Cmaj7", "6": "B7", "9": "Em", "15": "Dm7", "18": "G" }
        },
        {
            "text": "愛を伝えられたらいいな",
            "chords": { "0": "Cmaj7", "3": "B7", "8": "Em" }
        },
        {
            "text": "そう願っても無駄だから グッバイ",
            "chords": { "0": "Am", "9": "D" }
        },
        {
            "text": "君の運命のヒトは僕じゃない",
            "chords": { "0": "G", "8": "D", "11": "B7" }
        },
        {
            "text": "辛いけど否めない でも離れ難いのさ",
            "chords": { "0": "Em", "10": "Dm7", "13": "G", "16": "Cmaj7" }
        },
        {
            "text": "その髪に触れただけで 痛いや いやでも",
            "chords": { "3": "Bm7", "10": "Am" }
        },
        {
            "text": "甘いな いやいや",
            "chords": { "0": "D" }
        },
        {
            "text": "グッバイ",
            "chords": { "0": "D" }
        },
        {
            "text": "それじゃ僕にとって君は何?",
            "chords": { "0": "G", "6": "D", "9": "B7" }
        },
        {
            "text": "答えは分からない 分かりたくもないのさ",
            "chords": { "0": "Em", "8": "Dm7", "12": "G", "16": "Cmaj7" }
        },
        {
            "text": "たったひとつ確かなことがあるとするのならば",
            "chords": { "5": "Bm7", "14": "Am", "21": "D" }
        },
        {
            "text": "「君は綺麗だ」",
            "chords": { "1": "G" }
        },
        {
            "text": "誰かが偉そうに",
            "chords": { "0": "G", "3": "D" }
        },
        {
            "text": "語る 恋愛の 論理",
            "chords": { "0": "B7", "3": "Em" }
        },
        {
            "text": "何ひとつとしてピンとこなくて",
            "chords": { "6": "A" }
        },
        {
            "text": "飛行機の窓から見下ろした",
            "chords": { "0": "Am", "9": "D" }
        },
        {
            "text": "知らない街の夜景みたいだ",
            "chords": { "0": "G" }
        },
        {
            "text": "もっと違う設定で もっと違う関係で",
            "chords": { "0": "Cmaj7", "6": "B7", "9": "Em", "15": "Dm7", "18": "G" }
        },
        {
            "text": "出会える世界線 選べたらよかった",
            "chords": { "0": "Cmaj7", "6": "B7", "8": "Em", "13": "Dm7" }
        },
        {
            "text": "いたって純な心で 叶った恋を抱きしめて",
            "chords": { "0": "Cmaj7", "6": "B7", "9": "Em", "15": "Dm7", "18": "G" }
        },
        {
            "text": "「好きだ」とか無責任に言えたらいいな",
            "chords": { "0": "Cmaj7", "6": "B7", "10": "Em" }
        },
        {
            "text": "そう願っても虚しいのさ グッバイ",
            "chords": { "0": "Am", "9": "D" }
        },
        {
            "text": "繋いだ手の向こうにエンドライン",
            "chords": { "0": "G", "8": "D", "11": "B7" }
        },
        {
            "text": "引き伸ばすたびに 疼きだす未来には",
            "chords": { "0": "Em", "7": "Dm7", "10": "G", "13": "Cmaj7" }
        },
        {
            "text": "君はいない その事実に Cry...",
            "chords": { "3": "Bm7", "10": "Am" }
        },
        {
            "text": "そりゃ苦しいよな",
            "chords": { "0": "D" }
        },
        {
