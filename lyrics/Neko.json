        "0": "D",
        "9": "A"
      }
    },
    {
      "text": "このどうしようもない気だるさも",
      "chords": {
        "0": "G",
        "13": "D"
      }
    },
    {
      "text": "心と体が喧嘩して",
      "chords": {
        "0": "G",
        "4": "D"
      }
    },
    {
      "text": "頼りない僕は寝転んで",
      "chords": {
        "0": "Em",
        "6": "A"
      }
    },
    {
      "text": "猫になったんだよな君は",
      "chords": {
        "0": "D",
        "8": "F#7"
      }
    },
    {
      "text": "いつかフラッと現れてくれ",
      "chords": {
        "3": "Bm",
        "8": "Am",
        "10": "D"
      }
    },
    {
      "text": "何気ない毎日を",
