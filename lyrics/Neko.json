    {
      "text": "夕焼けが燃えてこの街ごと",
      "chords": {
        "0": "D",
        "8": "A"
      }
    },
    {
      "text": "飲み込んでしまいそうな今日に",
      "chords": {
        "0": "F#m7",
        "10": "Bm"
      }
    },
    {
      "text": "僕は君を手放してしまった",
      "chords": {
        "0": "G",
        "9": "A"
      }
    },
    {
      "text": "明日が不安だ とても嫌だ",
      "chords": {
        "0": "D",
        "7": "A"
      }
    },
    {
      "text": "だからこの僕も一緒に",
      "chords": {
        "0": "F#m",
        "6": "Bm"
      }
    },
    {
      "text": "飲み込んでしまえよ夕焼け",
      "chords": {
        "0": "G",
        "7": "A",
        "9": "D",
        "11": "A7"
      }
    },
    {
      "text": "だけどもそうはいかないよな",
      "chords": {
        "0": "D",
        "8": "A"
      }
    },
    {
      "text": "明日ってウザいほど来るよな",
      "chords": {
        "0": "F#m",
        "9": "Bm"
      }
    },
    {
      "text": "眠たい夜になんだか笑っちゃう",
      "chords": {
        "0": "G",
        "7": "A",
        "13": "D"
      }
    },
    {
      "text": "家まで帰ろう 1人で帰ろう",
      "chords": {
        "0": "G",
        "3": "A",
        "7": "D",
        "10": "Bm"
      }
    },
    {
      "text": "昨日のことなど 幻だと思おう",
      "chords": {
        "0": "G",
        "3": "A",
        "7": "F#m",
        "11": "Bm"
      }
    },
    {
      "text": "君の顔なんて 忘れてやるさ",
      "chords": {
